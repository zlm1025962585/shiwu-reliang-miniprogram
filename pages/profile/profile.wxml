<view class="page">
  <view class="head">
    <view class="h-title">我的</view>
  </view>

  <view class="card hero">
    <text class="muted small">每日推荐摄入</text>
    <view class="hero-num">
      <text class="num big">{{target}}</text>
      <text class="unit">kcal</text>
    </view>
    <view class="formula">基础代谢 {{bmr}} · 日常消耗 {{tdee}}</view>
    <view class="advice">{{advice}}</view>
  </view>

  <view class="card block">
    <view class="between">
      <text class="title">身体数据</text>
      <text class="muted small">用来算你的基准</text>
    </view>

    <view class="field">
      <text class="fl">性别</text>
      <view class="seg">
        <view
          class="seg-i {{profile.gender === 'male' ? 'seg-on' : ''}}"
          data-v="male"
          bindtap="onGender"
        >男</view>
        <view
          class="seg-i {{profile.gender === 'female' ? 'seg-on' : ''}}"
          data-v="female"
          bindtap="onGender"
        >女</view>
      </view>
    </view>

    <view class="field">
      <text class="fl">年龄</text>
      <view class="fr">
        <input class="fi" type="number" value="{{form.age}}" data-field="age" bindinput="onInput" />
        <text class="fu">岁</text>
      </view>
    </view>

    <view class="field">
      <text class="fl">身高</text>
      <view class="fr">
        <input class="fi" type="number" value="{{form.height}}" data-field="height" bindinput="onInput" />
        <text class="fu">cm</text>
      </view>
    </view>

    <view class="field">
      <text class="fl">体重</text>
      <view class="fr">
        <input class="fi" type="number" value="{{form.weight}}" data-field="weight" bindinput="onInput" />
        <text class="fu">kg</text>
      </view>
    </view>

    <view class="field">
      <text class="fl">活动量</text>
      <picker range="{{activityLabels}}" value="{{activityIndex}}" bindchange="onActivity">
        <view class="picker">{{activityLabel}} <text class="pk-arrow">›</text></view>
      </picker>
    </view>
  </view>

  <view class="card block">
    <text class="title">目标</text>
    <view class="chips">
      <view
        class="chip {{profile.goal === item.key ? 'chip-on' : ''}}"
        wx:for="{{goals}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onGoal"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="card block list">
    <view class="lrow" bindtap="goSettings">
      <view class="lr-main">
        <text class="lr-t">AI 设置</text>
        <text class="lr-s {{hasKey ? '' : 'hint'}}">{{apiStatus}}</text>
      </view>
      <text class="lr-arrow">›</text>
    </view>

    <view class="lrow">
      <view class="lr-main">
        <text class="lr-t">累计记录</text>
        <text class="lr-s">{{dayCount}} 天 · {{mealCount}} 餐</text>
      </view>
    </view>

    <view class="lrow" bindtap="onClear">
      <view class="lr-main">
        <text class="lr-t danger">清空所有记录</text>
      </view>
      <text class="lr-arrow">›</text>
    </view>
  </view>

  <view class="ver" bindlongpress="onVerLong">食刻 v1.1 · 营养数据为估算值，仅供日常参考</view>
</view>
