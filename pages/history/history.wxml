<view class="page">
  <view class="head">
    <view class="h-title">趋势</view>
  </view>

  <view class="card chart-card">
    <view class="between">
      <text class="muted small">{{rangeText}}摄入</text>
      <text class="muted small">目标 {{target}}</text>
    </view>

    <view class="chart">
      <view class="bar-col" wx:for="{{bars}}" wx:key="date">
        <view class="bar-box">
          <view
            class="bar-v {{item.over ? 'bar-v-over' : ''}}"
            style="height: {{item.height}}%"
          ></view>
        </view>
        <text class="bar-label {{item.isToday ? 'bar-label-on' : ''}}">{{item.short}}</text>
      </view>
    </view>

    <view class="stats">
      <view class="stat">
        <text class="s-v num">{{avg}}</text>
        <text class="s-k">日均 kcal</text>
      </view>
      <view class="s-line"></view>
      <view class="stat">
        <text class="s-v num">{{daysCount}}</text>
        <text class="s-k">记录天数</text>
      </view>
      <view class="s-line"></view>
      <view class="stat">
        <text class="s-v num">{{overCount}}</text>
        <text class="s-k">超标天数</text>
      </view>
    </view>
  </view>

  <block wx:if="{{hasData}}">
    <view class="day" wx:for="{{days}}" wx:key="date">
      <view class="between day-head">
        <text class="d-label">{{item.label}}</text>
        <text class="d-kcal num {{item.over ? 'd-over' : ''}}">{{item.kcal}} kcal</text>
      </view>

      <view class="card day-card">
        <view
          class="mrow"
          wx:for="{{item.meals}}"
          wx:for-item="meal"
          wx:key="id"
          data-id="{{meal.id}}"
          bindlongpress="onDelete"
        >
          <view class="m-col">
            <view class="m-top">
              <text class="m-type">{{meal.typeLabel}}</text>
              <text class="m-time">{{meal.time}}</text>
            </view>
            <view class="m-items">{{meal.itemsText}}</view>
          </view>
          <text class="m-kcal num">{{meal.kcal}}</text>
        </view>
      </view>
    </view>
  </block>

  <view class="card empty-card" wx:else>
    <view class="empty-emoji">📈</view>
    <view class="empty-t">还没有历史记录</view>
    <view class="empty-s">去「记录」拍第一餐吧</view>
  </view>
</view>
