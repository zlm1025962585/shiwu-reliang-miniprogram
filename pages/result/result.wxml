<view class="page">
  <view class="photo-wrap" wx:if="{{image}}">
    <image class="photo" src="{{image}}" mode="aspectFill"></image>
    <view class="tip" wx:if="{{note}}">{{note}}</view>
  </view>

  <view class="card block">
    <view class="between">
      <text class="title">识别结果</text>
      <text class="muted small">{{items.length}} 项</text>
    </view>

    <view class="hint" wx:if="{{!items.length}}">
      没认出食物。点下面的按钮，从内置食物库里挑，几秒钟就能记好。
    </view>

    <view class="item {{index === 0 ? 'item-first' : ''}}" wx:for="{{items}}" wx:key="uid">
      <view class="item-main">
        <view class="name-row">
          <input
            class="item-name"
            value="{{item.name}}"
            data-index="{{index}}"
            bindinput="onName"
            bindblur="onNameBlur"
            maxlength="24"
          />
          <text
            class="fix {{item.manual ? 'fix-on' : ''}}"
            data-index="{{index}}"
            catchtap="openEdit"
          >{{item.manual ? '已修正' : '修正'}}</text>
        </view>
        <view class="item-sub">
          {{item.kcal}} kcal · 蛋白 {{item.protein}}g · 碳水 {{item.carb}}g · 脂肪 {{item.fat}}g
        </view>
      </view>
      <view class="gram">
        <input
          class="gram-input"
          type="number"
          value="{{item.gramsText}}"
          data-index="{{index}}"
          bindinput="onGrams"
        />
        <text class="gram-unit">{{item.unit}}</text>
      </view>
      <view class="del" data-index="{{index}}" bindtap="onRemove">×</view>
    </view>

    <view class="add" bindtap="goPickFood">
      <text class="add-plus">＋</text>
      <text>手动添加食物</text>
    </view>
  </view>

  <view class="card block">
    <view class="between">
      <text class="title">这一餐合计</text>
      <view class="total">
        <text class="num t-num">{{total.kcal}}</text>
        <text class="t-unit">kcal</text>
      </view>
    </view>
    <view class="macro-row">
      <view class="mrow">
        <text class="mk">蛋白质</text>
        <text class="mv2 num">{{total.protein}} g</text>
      </view>
      <view class="mrow">
        <text class="mk">碳水</text>
        <text class="mv2 num">{{total.carb}} g</text>
      </view>
      <view class="mrow">
        <text class="mk">脂肪</text>
        <text class="mv2 num">{{total.fat}} g</text>
      </view>
    </view>
  </view>

  <view class="card block">
    <text class="title">算在哪一餐</text>
    <view class="chips">
      <view
        class="chip {{mealType === item.key ? 'chip-on' : ''}}"
        wx:for="{{mealTypes}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onPickType"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="footer">
    <view class="btn btn-primary" bindtap="onSave">保存这一餐</view>
    <view class="foot-note">营养数据由模型估算，认错了点每行右侧的「修正」改</view>
  </view>

  <view class="mask" wx:if="{{edit}}" bindtap="closeEdit"></view>
  <view class="sheet" wx:if="{{edit}}" catchtap="noop">
    <view class="sheet-handle"></view>
    <view class="between">
      <view class="s-head">
        <text class="s-title">手动修正</text>
        <text class="s-for">{{edit.name}} · 这一份</text>
      </view>
      <text class="s-x" bindtap="closeEdit">✕</text>
    </view>

    <view class="s-hint">填的是这一份的总量，保存后合计会自动重算。改份量时其余数值按比例跟着走。</view>

    <view class="frow">
      <text class="flabel">份量</text>
      <input
        class="finput"
        type="number"
        value="{{edit.gramsText}}"
        bindinput="onEditGrams"
      />
      <text class="funit">{{edit.unit}}</text>
    </view>

    <view class="frow">
      <text class="flabel">热量</text>
      <input
        class="finput"
        type="digit"
        value="{{edit.kcalText}}"
        data-field="kcalText"
        bindinput="onEditField"
      />
      <text class="funit">kcal</text>
    </view>

    <view class="frow">
      <text class="flabel">蛋白质</text>
      <input
        class="finput"
        type="digit"
        value="{{edit.pText}}"
        data-field="pText"
        bindinput="onEditField"
      />
      <text class="funit">g</text>
    </view>

    <view class="frow">
      <text class="flabel">碳水</text>
      <input
        class="finput"
        type="digit"
        value="{{edit.cText}}"
        data-field="cText"
        bindinput="onEditField"
      />
      <text class="funit">g</text>
    </view>

    <view class="frow">
      <text class="flabel">脂肪</text>
      <input
        class="finput"
        type="digit"
        value="{{edit.fText}}"
        data-field="fText"
        bindinput="onEditField"
      />
      <text class="funit">g</text>
    </view>

    <view class="s-btns">
      <view class="sbtn sbtn-ghost" bindtap="goRepick">从库里重选</view>
      <view class="sbtn sbtn-main" bindtap="saveEdit">保存</view>
    </view>
  </view>
</view>
