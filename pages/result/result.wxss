.photo-wrap { margin: 24rpx; border-radius: 28rpx; overflow: hidden; }
.photo { width: 100%; height: 420rpx; display: block; }
.loading { font-size: 32rpx; font-weight: 600; margin-bottom: 10rpx; }
.demo-banner { margin: 20rpx 24rpx 0; background: #fff4e0; color: #92580a; border-radius: 16rpx; padding: 18rpx 22rpx; font-size: 25rpx; line-height: 1.5; }
.demo-banner.error { background: #ffe9e9; color: #a61e1e; }
.card-title { font-size: 30rpx; font-weight: 600; }
.food-row { padding: 20rpx 0; border-top: 1rpx solid #f0f3f0; }
.food-name { font-size: 30rpx; font-weight: 600; }
.conf { font-size: 22rpx; color: #8a938a; font-weight: 400; margin-left: 10rpx; }
.conf.warn { color: #e8590c; }
.grams-row { display: flex; align-items: center; gap: 12rpx; margin-top: 12rpx; }
.step { font-size: 24rpx; padding: 0 18rpx; line-height: 2; background: #eaf5ec; color: #2f9e44; border-radius: 30rpx; margin: 0; }
.grams-input { width: 110rpx; text-align: center; background: #f6f8f6; border-radius: 12rpx; padding: 8rpx 0; }
.del { color: #e03131; font-size: 24rpx; margin-left: 14rpx; }
.total-row { display: flex; align-items: center; border-top: 2rpx solid #eef3ee; padding-top: 20rpx; margin-top: 6rpx; font-size: 30rpx; font-weight: 600; }
.total-kcal { color: #e8590c; font-size: 40rpx; font-weight: 800; }
.nutrients { gap: 24rpx; font-size: 25rpx; margin-top: 10rpx; flex-wrap: wrap; }
.save-btn { margin-top: 26rpx; }
.search { background: #f6f8f6; border-radius: 16rpx; padding: 18rpx 22rpx; margin-top: 8rpx; }
.pick-list { max-height: 560rpx; overflow: auto; }
.pick-item { display: flex; align-items: center; gap: 12rpx; padding: 18rpx 0; border-top: 1rpx solid #f0f3f0; }
.add { color: #2f9e44; font-size: 36rpx; font-weight: 700; }
.empty { padding: 16rpx 0; }
.foot { margin: 10rpx 36rpx 40rpx; line-height: 1.6; }
