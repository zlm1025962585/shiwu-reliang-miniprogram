.hero { background: linear-gradient(135deg, #2f9e44, #40b35a); color: #fff; margin: 24rpx; border-radius: 28rpx; padding: 36rpx 30rpx; }
.hero-title { font-size: 40rpx; font-weight: 700; }
.hero-sub { opacity: .9; margin-top: 10rpx; font-size: 26rpx; }
.hero-btns { display: flex; gap: 20rpx; margin-top: 30rpx; }
.hero-btn { flex: 1; }
.hero-note { color: rgba(255,255,255,.85); margin-top: 20rpx; line-height: 1.5; }
.hero-manual { margin-top: 18rpx; font-size: 26rpx; text-decoration: underline; }
.card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 12rpx; }
.big-kcal { font-size: 56rpx; font-weight: 800; color: #e8590c; }
.ring-wrap { width: 110rpx; }
.ring { position: relative; width: 100rpx; height: 100rpx; border-radius: 50%; border: 6rpx solid #eaf5ec; overflow: hidden; margin: 0 auto; }
.ring-fill { position: absolute; bottom: 0; left: 0; right: 0; background: #ffd8a8; }
.ring-text { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 700; }
.bar { height: 14rpx; background: #eef3ee; border-radius: 8rpx; margin: 18rpx 0 10rpx; overflow: hidden; }
.bar-fill { height: 100%; background: #2f9e44; border-radius: 8rpx; }
.nutrients { gap: 24rpx; font-size: 25rpx; margin-top: 8rpx; flex-wrap: wrap; }
.over { color: #e03131; font-size: 24rpx; }
.recent-item { display: flex; align-items: center; gap: 18rpx; padding: 16rpx 0; border-top: 1rpx solid #f0f3f0; }
.thumb { width: 88rpx; height: 88rpx; border-radius: 16rpx; background: #eef3ee; }
.recent-main { flex: 1; }
.tip { line-height: 1.6; }
