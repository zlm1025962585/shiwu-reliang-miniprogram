<view class="page">
  <view class="head">
    <view class="date">{{dateLabel}}</view>
    <view class="greet">{{greeting}}</view>
  </view>

  <view class="card hero">
    <view class="between hero-top">
      <text class="muted small">今日已摄入</text>
      <text class="muted small">目标 {{target}} kcal</text>
    </view>

    <view class="hero-num">
      <text class="num big {{over ? 'over' : ''}}">{{total.kcal}}</text>
      <text class="unit">kcal</text>
    </view>

    <view class="bar">
      <view class="bar-fill {{over ? 'bar-over' : ''}}" style="width: {{percent}}%"></view>
    </view>

    <view class="between hero-foot">
      <text class="foot-text {{over ? 'over' : ''}}">{{remainText}}</text>
      <text class="muted small">{{percent}}%</text>
    </view>

    <view class="macros">
      <view class="macro">
        <text class="mv num">{{total.protein}}</text>
        <text class="ml">🥩 蛋白质 g</text>
      </view>
      <view class="macro-line"></view>
      <view class="macro">
        <text class="mv num">{{total.carb}}</text>
        <text class="ml">🍚 碳水 g</text>
      </view>
      <view class="macro-line"></view>
      <view class="macro">
        <text class="mv num">{{total.fat}}</text>
        <text class="ml">🥑 脂肪 g</text>
      </view>
    </view>
  </view>

  <view class="snap" bindtap="onTapSnap">
    <view class="snap-icon">📷</view>
    <view class="snap-body">
      <view class="snap-t">拍照记这一餐</view>
      <view class="snap-s">拍一张，自动认出食物和热量</view>
    </view>
    <view class="snap-arrow">→</view>
  </view>

  <view class="section" wx:if="{{count > 0}}">
    <view class="section-head between">
      <text class="title">今天的记录</text>
      <text class="muted small">{{count}} 条 · 长按可删</text>
    </view>

    <view class="card group" wx:for="{{groups}}" wx:key="key">
      <view class="between group-head">
        <text class="g-label">{{item.icon}} {{item.label}}</text>
        <text class="g-kcal num">{{item.kcal}} kcal</text>
      </view>

      <view
        class="meal"
        wx:for="{{item.meals}}"
        wx:for-item="meal"
        wx:key="id"
        data-id="{{meal.id}}"
        bindlongpress="onDelete"
      >
        <image class="thumb" src="{{meal.image}}" mode="aspectFill" wx:if="{{meal.image}}"></image>
        <view class="thumb thumb-ph" wx:else>🍽</view>
        <view class="meal-body">
          <view class="meal-name">{{meal.itemsText}}</view>
          <view class="meal-sub">{{meal.time}} · {{meal.kcal}} kcal</view>
        </view>
      </view>
    </view>
  </view>

  <view class="card empty-card" wx:else>
    <view class="empty-emoji">🍚</view>
    <view class="empty-t">今天还没记录</view>
    <view class="empty-s">拍一张，看看这顿吃了多少</view>
  </view>
</view>
